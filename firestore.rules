rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Admins are identified by a custom claim set out-of-band (see README /
    // .env.example): firebase auth:set-custom-claims. A client-side passcode is
    // NEVER sufficient — the Admin Studio passcode is a UX gate only, so every
    // privileged write must also prove this claim here.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && uid() == ownerUid;
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    // A user reads/writes their own profile. Admins may read every profile so the
    // Admin Studio roster can list registered students.
    match /users/{ownerUid} {
      allow read: if isOwner(ownerUid) || isAdmin();
      allow write: if isOwner(ownerUid) || isAdmin();
    }

    // ── Test Submissions ──────────────────────────────────────────────────────
    // Students create and read their own submissions. Nobody can update them
    // (exam integrity); owner/admin may delete.
    match /test_submissions/{submissionId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // Legacy collection name — kept so older records remain readable.
    match /mock_submissions/{submissionId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── In-progress Test Drafts (autosave) ────────────────────────────────────
    match /test_drafts/{draftId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read, update, delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── Practice Attempt Telemetry ────────────────────────────────────────────
    match /practice_attempts/{attemptId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── Published Papers & Question Bank (authoritative content) ─────────────
    // Every student must READ these; only a verifiable admin may WRITE them.
    // Without this, any anonymous session could rewrite answer keys for everyone.
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /published_papers/{paperId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /custom_mock_tests/{mockId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Syllabus Progress / Study Plans (per-user) ────────────────────────────
    match /syllabus_progress/{ownerUid} {
      allow read, write: if isOwner(ownerUid);
    }

    match /study_plans/{ownerUid} {
      allow read, write: if isOwner(ownerUid);
    }

    // ── Chat History (owner-only, including the messages subcollection) ───────
    // NOTE: rules do not cascade into subcollections, so the messages path needs
    // its own match block — otherwise every chat write is silently denied.
    match /ai_chats/{ownerUid} {
      allow read, write: if isOwner(ownerUid);

      match /messages/{messageId} {
        allow read, write: if isOwner(ownerUid);
      }
    }

    // ── Global Syllabus Tree ──────────────────────────────────────────────────
    // Readable by all students; only admins may change the catalog itself.
    match /syllabus/{examId}/topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Everything else is DENIED ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
