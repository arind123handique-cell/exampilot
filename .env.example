# Firebase Configuration
# Replace these values with your actual Firebase Project keys from the Firebase Console (https://console.firebase.google.com)
# The application includes an automatic fallback / demo mode if these are not set.

## Preferred (private) variables for CI: set these as secrets in your hosting/CI.
CONFIG_FIREBASE_API_KEY=your_firebase_api_key_here
CONFIG_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
CONFIG_FIREBASE_PROJECT_ID=your_project_id
CONFIG_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
CONFIG_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
CONFIG_FIREBASE_APP_ID=your_app_id

# Backwards-compatible Vite public envs (only for local dev; these values are inlined into the build):
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Gemini AI (optional - enables live AI Tutor, MCQ AI Deep Dive and AI question drafting)
# Get a key at https://aistudio.google.com/apikey - or add it at runtime via the AI Ingestion Studio.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Analytics measurement ID (optional)
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Admin Portal Security ─────────────────────────────────────────────────────
# The passcode is ONLY a local UX gate. It is NOT access control: anything in a
# VITE_* variable is inlined into the public bundle, and a client-side check can
# always be bypassed. Real authorization lives in firestore.rules, which requires
# an `admin` custom claim for every write to the question bank, published papers
# and mock tests.
#
# 1) Set the passcode as a SHA-256 hash so the plaintext never ships:
#    node -e "console.log(require('crypto').createHash('sha256').update('YOUR_STRONG_PASSCODE').digest('hex'))"
#    then paste the 64-char hex digest below.
VITE_ADMIN_PASSCODE_SHA256=your_admin_passcode_sha256_hash_here
#
#    Deprecated: plaintext fallback, still supported for existing deployments.
#    Prefer the hash above. NEVER use "admin", "admin123" or "admin2026".
# VITE_ADMIN_PASSCODE=
#
# 2) Grant the admin claim to the account that should be able to publish content:
#    firebase auth:import / or the Admin SDK in a trusted server context — e.g.
#      admin.auth().setCustomUserClaims(uid, { admin: true })
#    The signed-in user must sign out/in (or refresh their token) afterwards.

# Optional model override. Leave unset unless you need to pin a specific model:
# the app tries the recent GA flash models in order and falls back on 404/429/503,
# because a hard-coded model name is how every live AI feature silently broke when
# Google shut down the Gemini 1.5 family.
# VITE_GEMINI_MODEL=gemini-3.8-flash
