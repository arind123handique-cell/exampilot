# Firebase Configuration
# Replace these values with your actual Firebase Project keys from the Firebase Console
# https://console.firebase.google.com → Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini AI (optional)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Admin Portal Security (SHA-256 hash of your passcode)
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSCODE').digest('hex'))"
VITE_ADMIN_PASSCODE_SHA256=your_admin_passcode_sha256_hash_here
